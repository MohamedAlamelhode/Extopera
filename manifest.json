{
  "manifest_version": 3,
  "name": "اتجاه عربي للمواقع",
  "version": "1.0.0",
  "description": "فعّل اتجاه RTL على مواقع الويب التي تختارها.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "اتجاه عربي للمواقع",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["rtl.css"],
      "run_at": "document_start"
    }
  ]
}